{
  "manifest_version": 3,
  "name": "Afterparty Connector",
  "version": "1.1.0",
  "description": "Connects your Partiful account to Afterparty. Reads your Partiful sign-in only when Afterparty asks.",
  "key": "",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://partiful.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "action": {
    "default_title": "Afterparty Connector",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
