# Afterparty settings. Copy to .env and fill in. Every value is optional unless marked.

# --- required -------------------------------------------------------------------------
# Encrypts the Partiful sign-in tokens at rest. Generate one (keep it secret, back it up):
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# --- how people sign in ---------------------------------------------------------------
# dev = local mode: sign in with any email, no password. Only on a machine nobody else
# can reach. prod = Firebase Authentication (Google or email link): see docs/self-hosting.md.
APP_ENV=dev
# Firebase only (APP_ENV=prod): your project id and its public web config as one line of JSON.
FIREBASE_PROJECT_ID=afterparty-local
FIREBASE_WEB_CONFIG={}

# Approve every new sign-in (a personal instance). Leave false on a shared instance:
# admins then approve each request on the Access page.
AUTO_APPROVE=true
# Comma-separated. These accounts are approved and see the Access page.
ADMIN_EMAILS=

# --- where it runs --------------------------------------------------------------------
# The address people open. The connector zip only answers this address.
PUBLIC_URL=http://localhost:8080
# Postgres. docker-compose.yml sets this for you.
# DATABASE_URL=postgresql://user:password@host:5432/afterparty

# --- daily sync -----------------------------------------------------------------------
# Sync everyone once a day from inside the server. Simplest on one machine.
BACKGROUND_SYNC=true
# Or call POST /internal/sync-all from cron or any scheduler with this bearer token.
CRON_SECRET=

# --- connector ------------------------------------------------------------------------
# Leave empty to use the unpacked connector in extension/. If you publish your own copy
# in the Chrome Web Store, add its item id here and set its store page below.
EXTENSION_ID=
CONNECTOR_STORE_URL=

# --- optional -------------------------------------------------------------------------
# Telegram message to the admin for each new access request.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Seconds between Partiful requests during a sync.
PARTIFUL_DELAY=0.3

# Google Cloud only: encrypt with a KMS key instead of ENCRYPTION_KEY (build with EXTRAS=gcp),
# and accept Cloud Scheduler's OIDC token on /internal/sync-all.
KMS_KEY=
SERVICE_URL=
SCHEDULER_SA=
